# CONTACT_EMAIL_USER / CONTACT_EMAIL_PASS: Gmail account (use an App Password, not
# your login password) that sends contact-form submissions. Server-only.
CONTACT_EMAIL_USER="you@gmail.com"
CONTACT_EMAIL_PASS="your-gmail-app-password"

# CONTACT_EMAIL_TO: Optional. Where contact-form submissions are delivered.
# Defaults to CONTACT_EMAIL_USER if unset.
CONTACT_EMAIL_TO="you@gmail.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
